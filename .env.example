POSTGRES_USER=doxket
POSTGRES_PASSWORD=change-me
POSTGRES_DB=doxket

MAX_UPLOAD_MB=25
OCR_LANG=eng
WORKER_REPLICAS=5

# Optional AI review through any OpenAI-compatible API.
# Gemini (default): key from https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-4-argon
LLM_TIMEOUT=90
# Any OpenAI-compatible endpoint with tool calling and image input works (OpenAI, OpenRouter, vLLM...).
AGENT_MAX_STEPS=24
AGENT_MAX_IMAGES=14

# USD per 1M tokens for cost tracking (output includes thinking). gemini-4-argon until 30 Nov 2026: 2.00 / 0.10 / 10.00
# gemini-3.8-flash until 31 Dec 2026: 0.75 / 0.075 / 3.75. Check https://ai.google.dev/gemini-api/docs/pricing
LLM_PRICE_INPUT_PER_M=2.00
LLM_PRICE_CACHED_PER_M=0.10
LLM_PRICE_OUTPUT_PER_M=10.00
